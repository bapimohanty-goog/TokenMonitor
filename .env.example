# Server Configuration
PORT=4000

# Google Cloud & BigQuery Configuration
# Set DEMO_MODE=false when connecting to a live GCP BigQuery Billing Export table.
# When DEMO_MODE=true, the backend serves realistic simulated Vertex AI billing + real-time telemetry data.
DEMO_MODE=true

GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=billing_export
BQ_TABLE=gcp_billing_export_resource_v1_XXXXXX_XXXXXX_XXXXXX
BQ_LOCATION=US

# Real-Time Telemetry (Cloud Logging Sink -> BigQuery)
BQ_REALTIME_DATASET=realtime_llm_telemetry
BQ_REALTIME_TABLE=token_usage_logs
REALTIME_CUTOFF_HOURS=24
